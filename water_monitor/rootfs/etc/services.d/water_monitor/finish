#!/usr/bin/execlineb -S0
# s6-overlay v3: halt, do NOT stop the supervision tree.
#
# This was `s6-svscanctl -t /var/run/s6/services`, the v2 idiom. v3 moved the
# scandir, so that call failed with "No such file or directory" on every
# shutdown — noisy, but inert: it never actually did anything. Repointing it at
# the v3 scandir (/run/service) was worse, because then it WORKED: it tore the
# supervision tree down underneath the services still stopping, and
# legacy-cont-init failed with "command exited 111".
#
# v3 documents halt as the way to bring the container down from a finish
# script, precisely so the shutdown sequence is not disrupted.
/run/s6/basedir/bin/halt
