# Copy this file to `secrets.yaml` in the same directory and fill in
# every value below. ESPHome refuses to compile if any !secret key
# referenced from the firmware YAML is missing.
#
# secrets.yaml is gitignored — never commit real credentials.
#
# To generate the API encryption key:
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
#
# Once you've generated the key, DO NOT regenerate it across reflashes —
# every Home Assistant integration paired against this device would need
# to be re-added.

api_encryption_key: "REPLACE_WITH_BASE64_32_BYTES"

ota_password: "REPLACE_WITH_A_STRONG_PASSWORD"

# Password for the fallback Wi-Fi hotspot that the device opens when it
# can't reach the configured network. Keep it strong — anyone within
# Wi-Fi range can otherwise reach the captive portal.
fallback_ap_password: "REPLACE_WITH_A_STRONG_PASSWORD"

# Basic-auth credentials for the on-device web UI at http://<ip>/
web_username: "admin"
web_password: "REPLACE_WITH_A_STRONG_PASSWORD"
